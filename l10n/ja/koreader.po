msgstr "%1 時間 %2 分"

# Language Settings
msgid "Show weather on sleep screen"
msgstr "スクリーンセーバーに天気を表示"

# Dashboard/Active Sleep Settings
msgid "Dashboard"
msgstr "ダッシュボード"

msgid "Weather dashboard"
msgstr "天気ダッシュボード"

msgid "Dashboard (Tap to set interval)"
msgstr "ダッシュボード（タップで間隔を設定）"

msgid "Shows weather fullscreen and refreshes periodically. Works on all devices. Tap screen to dismiss. Uses more battery than regular sleep screen."
msgstr "天気を全画面で表示し、定期的に更新します。すべての端末で使えます。画面をタップすると閉じます。通常のスクリーンセーバーよりバッテリーを多く使います。"

msgid "The dashboard will keep the device awake and regularly update weather data.\nThis will increase power consumption while the dashboard is active.\n\nContinue?"
msgstr "ダッシュボードは端末を起こしたままにして、天気データを定期的に更新します。\nダッシュボードの表示中は消費電力が増えます。\n\n続けますか？"

msgid "Active Sleep"
msgstr "アクティブスリープ"

msgid "Active Sleep (Tap to set interval)"
msgstr "アクティブスリープ（タップで間隔を設定）"

msgid "Active Sleep (Unsupported device)"
msgstr "アクティブスリープ（非対応の端末）"

msgid "Active Sleep (Enable Wi-Fi 'Turn on' first)"
msgstr "アクティブスリープ（先に Wi-Fi の「オンにする」を有効に）"

msgid "Active Sleep (Kobo experimental - hold for help)"
msgstr "アクティブスリープ（Kobo は試験的・長押しでヘルプ）"

msgid "Device wakes from sleep to refresh weather data. Saves power compared to the dashboard.\n\nSupported devices: Kindle. Kobo (experimental) see README for more information."
msgstr "端末がスリープから起きて天気データを更新します。ダッシュボードより電力を節約できます。\n\n対応端末：Kindle。Kobo（試験的）については README を参照してください。"

msgid "Active sleep will wake the device from sleep to update weather data.\nThis will increase power consumption while the device is locked.\n\nContinue?"
msgstr "アクティブスリープは、端末をスリープから起こして天気データを更新します。\n端末のロック中は消費電力が増えます。\n\n続けますか？"

msgid "Lock to Start"
msgstr "ロックして開始"

msgid "Hold to Start"
msgstr "長押しで開始"

msgid "Enable"
msgstr "有効"

# Debug Settings
msgid "Debug options enabled"
msgstr "デバッグ オプションを有効にしました"

msgid "Debug options disabled"
msgstr "デバッグ オプションを無効にしました"

# Error Messages
msgid "API error"
msgstr "API エラー"

msgid "Unknown error"
msgstr "不明なエラー"

msgid "Failed to parse response"
msgstr "応答を解析できませんでした"

msgid "Preserve Battery"
msgstr "バッテリーの節約"

msgid "Disable Active Sleep below this battery level. Set to 0 to turn off."
msgstr "バッテリー残量がこれを下回ると、アクティブスリープを無効にします。0 にすると、この機能はオフになります。"

