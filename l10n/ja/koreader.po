# Display Settings
msgid "Show header"
msgstr "ヘッダーを表示"

msgid "Battery indicator (%1)"
msgstr "バッテリー表示（%1）"

msgid "Shows the battery level on the lockscreen: as a thin bar along the bottom edge, or as an icon and percentage in the top right corner."
msgstr "ロック画面にバッテリー残量を表示します。画面の下端に沿った細いバー、または右上のアイコンとパーセンテージで表示します。"

msgid "Overrides (%1)"
msgstr "上書き（%1）"

msgid "Override the automatic content scaling and the screen rotation for the lockscreen."
msgstr "ロック画面の自動の拡大率と画面の回転を上書きします。"

msgid "update available"
msgstr "アップデートがあります"

msgid "Bottom bar"
msgstr "下部のバー"

msgid "Header"
msgstr "ヘッダー"

msgid "Bar thickness (%1)"
msgstr "バーの太さ（%1）"

msgid "Battery bar thickness"
msgstr "バッテリーバーの太さ"

msgid "Override scaling"
msgstr "拡大率を上書き"

msgid "Content Fill (%1%)"
msgstr "内容の割合（%1%）"

msgid "Content Fill Percentage"
msgstr "内容の割合（%）"

msgid "How much of the available screen height should be filled?"
msgstr "画面の高さのうち、どれだけを内容で埋めますか？"

msgid "Cover scaling"
msgstr "カバーの拡大縮小"

msgid "Fit to screen"
msgstr "画面に合わせる"

msgid "Zoom to fill"
msgstr "拡大して埋める"

msgid "Stretch to fill"
msgstr "引き伸ばして埋める"

