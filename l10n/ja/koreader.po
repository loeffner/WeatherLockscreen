msgstr "時間"

msgid "min"
msgstr "分"

msgid "minutes"
msgstr "分"

msgid "Clear cache"
msgstr "キャッシュを消去"

msgid "Clear weather cache"
msgstr "天気のキャッシュを消去"

msgid "Clear cached weather data and icons?"
msgstr "キャッシュされた天気データとアイコンを消去しますか？"

msgid "Cache cleared"
msgstr "キャッシュを消去しました"

msgid "Weather cache cleared"
msgstr "天気のキャッシュを消去しました"

msgid "No cache to clear"
msgstr "消去するキャッシュはありません"

