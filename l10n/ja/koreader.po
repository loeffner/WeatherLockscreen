# Hourly Forecast Settings
msgid "Forecast hours shown"
msgstr "表示する予報の時刻"

msgid "Forecast hours"
msgstr "予報の時刻"

msgid "Enter the hours to show (0-23), separated by commas. Leave empty for the default."
msgstr "表示する時刻（0-23）をカンマ区切りで入力してください。空欄にすると既定になります。"

# Temperature Scale Settings
msgid "Temperature Scale"
msgstr "温度の単位"

msgid "Celsius"
