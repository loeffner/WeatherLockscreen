msgstr "通常と同じ"

# Refresh indicator (header)
msgid "Refreshing, please wait…"
msgstr "更新しています。お待ちください…"

# Custom Interval Settings
msgid "Custom…"
msgstr "カスタム…"

msgid "Custom (%1)"
msgstr "カスタム（%1）"

msgid "Custom refresh interval"
msgstr "カスタムの更新間隔"

msgid "Set hours and minutes for the refresh interval."
msgstr "更新間隔の時間と分を設定してください。"

msgid "Hours"
msgstr "時間"

msgid "Minutes"
msgstr "分"

msgid "%1 h"
msgstr "%1 時間"

