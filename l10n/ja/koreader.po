msgid "Fallback (%1)"
msgstr "代替表示（%1）"

msgid "Book cover"
msgstr "ブックカバー"

msgid "Custom image"
msgstr "カスタム画像"

msgid "Random image"
msgstr "ランダムな画像"

msgid "Reading progress"
msgstr "読書進行状況"

