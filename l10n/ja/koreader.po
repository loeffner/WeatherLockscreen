msgid "Location"
msgstr "場所"

msgid "City, postal code, or coordinates"
msgstr "都市名、郵便番号、または座標"

msgid "Enter your postal code or city name"
msgstr "郵便番号か都市名を入力してください"

msgid "Search"
msgstr "検索"

msgid "Searching..."
msgstr "検索中..."

msgid "Select Location (1 result)"
msgstr "場所を選択（1 件）"

msgid "Select Location (%1 results)"
msgstr "場所を選択（%1 件）"

msgid "No location found"
msgstr "場所が見つかりません"

msgid "Search again"
msgstr "もう一度検索"

msgid "Location search failed: %1"
msgstr "場所の検索に失敗しました：%1"

msgid "Cancel"
msgstr "キャンセル"

msgid "Save"
msgstr "保存"

msgid "Delete"
msgstr "削除"

