msgstr "12 小时"

msgid "Custom…"
msgstr "自定义…"

msgid "Custom (%1)"
msgstr "自定义 (%1)"

msgid "Custom refresh interval"
msgstr "自定义刷新间隔"

msgid "Set hours and minutes for the refresh interval."
msgstr "设置刷新间隔的小时和分钟。"

msgid "Hours"
msgstr "小时"

msgid "Minutes"
msgstr "分钟"

msgid "%1 h"
msgstr "%1 时"

msgid "%1 min"
msgstr "%1 分"

