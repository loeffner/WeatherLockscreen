msgstr "满月"

msgid "Waning Gibbous"
msgstr "亏凸月"

msgid "Last Quarter"
msgstr "下弦月"

msgid "Third Quarter"
msgstr "下弦月"

msgid "Waning Crescent"
msgstr "残月"

msgid "Fallback (%1)"
msgstr "备用内容 (%1)"

msgid "Book cover"
msgstr "书籍封面"

