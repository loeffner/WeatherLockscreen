# Cache Settings
msgid "Cache Settings"
msgstr "Gyorsítótár beállításai"

msgid "Maximum Cache duration"
msgstr "Gyorsítótár maximális érvényessége"

msgid "When offline, cached weather data up to this age will be shown. Older data displays the configured fallback instead."
msgstr "Kapcsolat nélkül legfeljebb ilyen régi tárolt időjárási adatok jelennek meg. Régebbi adatok esetén a beállított tartalék megjelenítés lép életbe."

msgid "Minimum Cache duration"
msgstr "Gyorsítótár minimális érvényessége"

msgid "Minimum time between API requests when locking device. Within this period, cached data is used automatically."
msgstr "A készülék lezárásakor indított API-kérések közötti minimális idő. Ezen belül automatikusan a tárolt adatok használatosak."

msgid "Debug: Controls minimum time between API requests. Does not affect periodic refresh intervals."
msgstr "Hibakeresés: az API-kérések közötti minimális időt szabályozza. Az időszakos frissítés gyakoriságát nem érinti."

