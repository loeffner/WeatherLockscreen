msgid "Unknown error"
msgstr "Ismeretlen hiba"

msgid "Failed to parse response"
msgstr "Nem sikerült feldolgozni a választ"

msgid "Preserve Battery"
msgstr "Akkumulátor kímélése"

msgid "Disable Active Sleep below this battery level. Set to 0 to turn off."
msgstr "Az aktív alvás kikapcsolása ezen akkumulátortöltöttség alatt. A korlátozás kikapcsolásához állítsd 0-ra."

