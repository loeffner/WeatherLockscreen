# Language Settings
msgid "Show weather on sleep screen"
msgstr "Időjárás megjelenítése az alvóképernyőn"

# Dashboard/Active Sleep Settings
msgid "Dashboard"
msgstr "Irányítópult"

msgid "Weather dashboard"
msgstr "Időjárási irányítópult"

msgid "Dashboard (Tap to set interval)"
msgstr "Irányítópult (beállításhoz érintsd meg)"

msgid "Shows weather fullscreen and refreshes periodically. Works on all devices. Tap screen to dismiss. Uses more battery than regular sleep screen."
msgstr "Teljes képernyőn jeleníti meg az időjárást, és rendszeresen frissít. Minden készüléken működik. Bezáráshoz érintsd meg a képernyőt. A szokásos alvóképernyőnél több energiát fogyaszt."

msgid "The dashboard will keep the device awake and regularly update weather data.\nThis will increase power consumption while the dashboard is active.\n\nContinue?"
msgstr "Az irányítópult ébren tartja a készüléket, és rendszeresen frissíti az időjárási adatokat.\nEz növeli az energiafogyasztást, amíg az irányítópult aktív.\n\nFolytatod?"

msgid "Active Sleep"
msgstr "Aktív alvás"

msgid "Active Sleep (Tap to set interval)"
msgstr "Aktív alvás (Beállításhoz érintsd meg)"

msgid "Active Sleep (Unsupported device)"
msgstr "Aktív alvás (nem támogatott készülék)"

msgid "Active Sleep (Enable Wi-Fi 'Turn on' first)"
msgstr "Aktív alvás (Wi-Fi bekapcsolása szükséges)"

msgid "Active Sleep (Kobo experimental - hold for help)"
msgstr "Aktív alvás (Kobón kísérleti – segítséghez tartsd nyomva)"

msgid "Device wakes from sleep to refresh weather data. Saves power compared to the dashboard.\n\nSupported devices: Kindle. Kobo (experimental) see README for more information."
msgstr "A készülék felébred az alvó állapotból az időjárási adatok frissítéséhez. Az irányítópultnál kevesebb energiát fogyaszt.\n\nTámogatott készülékek: Kindle; Kobo (kísérleti, részletek a README-ben)."

msgid "Active sleep will wake the device from sleep to update weather data.\nThis will increase power consumption while the device is locked.\n\nContinue?"
msgstr "Az aktív alvás felébreszti a készüléket az időjárási adatok frissítéséhez.\nEz növeli az energiafogyasztást, amíg a készülék zárolva van.\n\nFolytatod?"

msgid "Lock to Start"
msgstr "Indítás lezárással"

msgid "Hold to Start"
msgstr "Indítás hosszú nyomással"

msgid "Enable"
msgstr "Engedélyezés"

# Debug Settings
msgid "Debug options enabled"
msgstr "Hibakeresési beállítások engedélyezve"

msgid "Debug options disabled"
msgstr "Hibakeresési beállítások letiltva"

